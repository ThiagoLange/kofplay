# Porta do daemon (KOF_SERVER_PORT tem precedência via env por convenção)
server.port=8081

# --- Opções do KofPlay (descomente para usar) ---
# Formato: chave=valor, comentários com #. Variáveis de ambiente
# KOF_<CHAVE_MAIUSCULA> têm precedência sobre este arquivo.

# Binário do compilador Kof usado pelo Runner (precisa estar no PATH do daemon).
# kofplay.kof-bin=kof

# Timeout por execução, em segundos (padrão 25, mínimo efetivo 1).
# kofplay.timeout-seconds=25

# Exige header `x-api-key` com este valor em /api/run e /api/submit.
# Vazio/ausente = auth desabilitada (modo demo local).
# kofplay.api-key=troque-esta-chave

# Arquivo de auditoria dos submits (padrão: submissions.jsonl no working dir).
# kofplay.history-file=submissions.jsonl
