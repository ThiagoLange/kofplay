// Daemon.kf — Servidor HTTP do KofPlay (Kof real, 0.6.4)
//
// Rotas: GET / (UI), GET /api/health, GET /api/lessons,
// POST /api/run {code, language?}, POST /api/submit {lessonId, code, language?}.
// language: "kof" (padrão) ou "portukof" (.ptkf); ausente/desconhecido = kof.
// Auth opcional via kofplay.api-key; log/auditoria em submissions.jsonl.

import java.lang.Exception

record RunRequest(String code, String language, String user)
record SubmitRequest(String lessonId, String code, String language, String user)

String submissionsPath() {
    return config.str("kofplay.history-file", "submissions.jsonl")
}

void logSubmit(String lessonId, String user, Bool passed, Int xp) {
    var p = Path(submissionsPath())
    var xpStr = "" + xp
    var line = "{\"lesson\":\"" + lessonId + "\",\"user\":\"" + user + "\",\"passed\":" + boolStrOf(passed) + ",\"xp\":" + xpStr + "}"
    if (p.exists()) {
        p.appendText(line + "\n")
    } else {
        p.writeText(line + "\n")
    }
}

String boolStrOf(Bool b) {
    if (b) {
        return "true"
    }
    return "false"
}

Bool authorized() {
    var want = config.str("kofplay.api-key", "")
    if (want == "") {
        return true
    }
    var got = header("x-api-key")
    if (got == null) {
        return false
    }
    if (got == want) {
        return true
    }
    return false
}

String unauthorizedJson() {
    return "{\"passed\":false,\"xpAwarded\":0,\"error\":\"unauthorized: x-api-key invalida ou ausente\"}"
}

class IndexCache {
    static String html = ""
    static String css = ""
    static String js = ""
}

String readPublic(String p1, String p2) {
    var a = Path(p1)
    if (a.exists()) {
        var t = a.readText()
        if (t != null) {
            return t
        }
    }
    var b = Path(p2)
    if (b.exists()) {
        var u = b.readText()
        if (u != null) {
            return u
        }
    }
    return ""
}

String loadIndex() {
    if (IndexCache.html != "") {
        return IndexCache.html
    }
    var c = readPublic("public/index.html", "kofplay/public/index.html")
    if (c == "") {
        return "<html><body><h1>KofPlay online</h1><p>UI nao encontrada. Use /api/health e /api/lessons.</p></body></html>"
    }
    IndexCache.html = c
    return c
}

String loadCss() {
    if (IndexCache.css != "") {
        return IndexCache.css
    }
    var c = readPublic("public/styles.css", "kofplay/public/styles.css")
    if (c == "") {
        return "/* kofplay: styles.css nao encontrado */"
    }
    IndexCache.css = c
    return c
}

String loadJs() {
    if (IndexCache.js != "") {
        return IndexCache.js
    }
    var c = readPublic("public/app.js", "kofplay/public/app.js")
    if (c == "") {
        return "/* kofplay: app.js nao encontrado */"
    }
    IndexCache.js = c
    return c
}

String healthJson(String portStr) {
    var timeoutStr = "" + runTimeout()
    var key = config.str("kofplay.api-key", "")
    var auth = "false"
    if (key != "") {
        auth = "true"
    }
    return "{\"status\":\"UP\",\"service\":\"kofplay\",\"port\":" + portStr + ",\"timeout_seconds\":" + timeoutStr + ",\"auth_required\":" + auth + ",\"kof_version\":" + json.encode(kofVersion()) + "}"
}

String submitJson(String lessonId, String code, String language, String rawUser) {
    if (lessonExists(lessonId) == false) {
        return "{\"passed\":false,\"xpAwarded\":0,\"error\":\"licao desconhecida: " + lessonId + "\"}"
    }
    var lesson = findLesson(lessonId)
    var result = runKofLang(lessonId, code, language)
    var passed = false
    if (result.exitCode() == 0) {
        if (result.stdout() == lesson.expected()) {
            passed = true
        }
    }
    var xpAwarded = 0
    if (passed) {
        xpAwarded = lesson.xp()
    }
    var xpStr = "" + xpAwarded
    logSubmit(lessonId, displayUser(rawUser), passed, xpAwarded)
    return "{\"passed\":" + boolStrOf(passed) + ",\"xpAwarded\":" + xpStr + ",\"expected\":" + json.encode(lesson.expected()) + ",\"got\":" + json.encode(result.stdout()) + ",\"run\":" + json.encode(result) + "}"
}

void startDaemon(Int port) {
    println("KofPlay rodando em http://localhost:" + port)
    log.info("KofPlay daemon iniciando na porta " + port)

    var portStr = "" + port
    var app = web.app()

    app.get("/") {
        log.info("REQ GET /")
        headerSet("Content-Type", "text/html; charset=utf-8")
        return loadIndex()
    }

    app.get("/styles.css") {
        log.info("REQ GET /styles.css")
        headerSet("Content-Type", "text/css; charset=utf-8")
        return loadCss()
    }

    app.get("/app.js") {
        log.info("REQ GET /app.js")
        headerSet("Content-Type", "application/javascript; charset=utf-8")
        return loadJs()
    }

    app.get("/api/health") {
        log.info("REQ GET /api/health")
        return healthJson(portStr)
    }

    app.get("/api/lessons") {
        log.info("REQ GET /api/lessons")
        return lessonsJson()
    }

    app.get("/api/ranking") {
        log.info("REQ GET /api/ranking")
        if (authorized() == false) {
            return unauthorizedJson()
        }
        return rankingJson()
    }

    app.post("/api/room/state") {
        log.info("REQ POST /api/room/state")
        if (authorized() == false) {
            return unauthorizedJson()
        }
        try {
            var req = json.decode<RoomRequest>(body())
            return roomStateJson(roomsDir(), req.room())
        } catch (Exception e) {
            var msg = e.getMessage()
            if (msg == null) {
                msg = "erro desconhecido"
            }
            return "{\"error\":" + json.encode(msg) + "}"
        }
    }

    app.post("/api/room/push") {
        log.info("REQ POST /api/room/push")
        if (authorized() == false) {
            return unauthorizedJson()
        }
        try {
            var req = json.decode<RoomRequest>(body())
            return roomPush(roomsDir(), req.room(), req.user(), req.code())
        } catch (Exception e) {
            var msg = e.getMessage()
            if (msg == null) {
                msg = "erro desconhecido"
            }
            return "{\"error\":" + json.encode(msg) + "}"
        }
    }

    app.post("/api/room/presence") {
        log.info("REQ POST /api/room/presence")
        if (authorized() == false) {
            return unauthorizedJson()
        }
        try {
            var req = json.decode<RoomRequest>(body())
            return roomTouch(roomsDir(), req.room(), req.user())
        } catch (Exception e) {
            var msg = e.getMessage()
            if (msg == null) {
                msg = "erro desconhecido"
            }
            return "{\"error\":" + json.encode(msg) + "}"
        }
    }

    app.post("/api/room/hold") {
        log.info("REQ POST /api/room/hold")
        if (authorized() == false) {
            return unauthorizedJson()
        }
        try {
            var req = json.decode<RoomRequest>(body())
            return roomHold(roomsDir(), req.room(), req.user())
        } catch (Exception e) {
            var msg = e.getMessage()
            if (msg == null) {
                msg = "erro desconhecido"
            }
            return "{\"error\":" + json.encode(msg) + "}"
        }
    }

    app.post("/api/room/release") {
        log.info("REQ POST /api/room/release")
        if (authorized() == false) {
            return unauthorizedJson()
        }
        try {
            var req = json.decode<RoomRequest>(body())
            return roomRelease(roomsDir(), req.room(), req.user())
        } catch (Exception e) {
            var msg = e.getMessage()
            if (msg == null) {
                msg = "erro desconhecido"
            }
            return "{\"error\":" + json.encode(msg) + "}"
        }
    }

    app.post("/api/run") {
        log.info("REQ POST /api/run")
        if (authorized() == false) {
            return unauthorizedJson()
        }
        try {
            var req = json.decode<RunRequest>(body())
            var result = runKofLang("run", req.code(), req.language())
            return json.encode(result)
        } catch (Exception e) {
            var msg = e.getMessage()
            if (msg == null) {
                msg = "erro desconhecido"
            }
            return "{\"exitCode\":-1,\"stdout\":\"\",\"stderr\":" + json.encode(msg) + ",\"status\":\"FAILED\",\"errorKind\":\"COMPILE\"}"
        }
    }

    app.post("/api/submit") {
        log.info("REQ POST /api/submit")
        if (authorized() == false) {
            return unauthorizedJson()
        }
        try {
            var req = json.decode<SubmitRequest>(body())
            return submitJson(req.lessonId(), req.code(), req.language(), req.user())
        } catch (Exception e) {
            var msg = e.getMessage()
            if (msg == null) {
                msg = "erro desconhecido"
            }
            return "{\"passed\":false,\"xpAwarded\":0,\"error\":" + json.encode(msg) + "}"
        }
    }

    app.listen(port)
}

// ---- turma: ranking + salas (opcoes 1 e 2) ----

String cleanUser(String u) {
    var sb = ""
    var i = 0
    while (i < u.length && sb.length < 24) {
        var c = u.charAt(i)
        if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 32 || c == 45 || c == 95) {
            sb = sb + u.substring(i, i + 1)
        }
        i = i + 1
    }
    return sb
}

String displayUser(String u) {
    if (u == null) {
        return "anon"
    }
    var s = cleanUser(u)
    if (s == "") {
        return "anon"
    }
    return s
}

List<String> splitLines(String s) {
    var out = listOf<String>()
    var start = 0
    var n = s.length
    var i = 0
    while (i < n) {
        if (s.charAt(i) == 10) {
            out.add(s.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.add(s.substring(start, n))
    return out
}

record Audit(String lesson, String user, Bool passed, Int xp)
record RankUser(String user, Int xp, List<String> lessons)
record FeedItem(String user, String lesson, Bool passed, Int xp)
record RankBoard(List<RankUser> users, List<FeedItem> feed)

Int indexOfRankUser(List<RankUser> users, String u) {
    var i = 0
    while (i < users.size()) {
        if (users.get(i).user() == u) {
            return i
        }
        i = i + 1
    }
    return -1
}

Bool containsStr(List<String> xs, String v) {
    var i = 0
    while (i < xs.size()) {
        if (xs.get(i) == v) {
            return true
        }
        i = i + 1
    }
    return false
}

String rankingJson() {
    var users = listOf<RankUser>()
    var feed = listOf<FeedItem>()
    var prev = File(submissionsPath()).readText()
    if (prev == null) {
        return json.encode(RankBoard(users, feed))
    }
    var lines = splitLines(prev)
    var i = 0
    while (i < lines.size()) {
        var line = lines.get(i)
        if (line.length > 0) {
            try {
                var a = json.decode<Audit>(line)
                var u = displayUser(a.user())
                var k = indexOfRankUser(users, u)
                if (k == -1) {
                    users.add(RankUser(u, 0, listOf<String>()))
                    k = users.size() - 1
                }
                var ru = users.get(k)
                var total = ru.xp() + a.xp()
                var ls = ru.lessons()
                if (a.passed() && containsStr(ls, a.lesson()) == false) {
                    var nl = listOf<String>()
                    var q = 0
                    while (q < ls.size()) {
                        nl.add(ls.get(q))
                        q = q + 1
                    }
                    nl.add(a.lesson())
                    ls = nl
                }
                users.set(k, RankUser(u, total, ls))
                feed.add(FeedItem(u, a.lesson(), a.passed(), a.xp()))
            } catch (Exception e) {
            }
        }
        i = i + 1
    }
    var start = 0
    if (feed.size() > 20) {
        start = feed.size() - 20
    }
    var tail = listOf<FeedItem>()
    var t = start
    while (t < feed.size()) {
        tail.add(feed.get(t))
        t = t + 1
    }
    var a2 = 0
    while (a2 < users.size()) {
        var b = a2 + 1
        while (b < users.size()) {
            if (users.get(b).xp() > users.get(a2).xp()) {
                var tmp = users.get(a2)
                users.set(a2, users.get(b))
                users.set(b, tmp)
            }
            b = b + 1
        }
        a2 = a2 + 1
    }
    return json.encode(RankBoard(users, tail))
}

String roomsDir() {
    return config.str("kofplay.rooms-dir", "rooms")
}

Bool validRoomId(String id) {
    if (id == null) {
        return false
    }
    var n = id.length
    if (n == 0 || n > 32) {
        return false
    }
    var i = 0
    while (i < n) {
        var c = id.charAt(i)
        if ((c >= 48 && c <= 57) || (c >= 97 && c <= 122) || c == 45) {
        } else {
            return false
        }
        i = i + 1
    }
    return true
}

record RoomUser(String user, Long seen)
record RoomState(String code, String updatedBy, Long updatedAt, List<RoomUser> users, String holder)
record RoomRequest(String room, String user, String code)

String roomPath(String dir, String id) {
    return dir + "/" + id + ".json"
}

List<RoomUser> touchUser(List<RoomUser> users, String u, Long now) {
    var out = listOf<RoomUser>()
    var found = 0
    var i = 0
    while (i < users.size()) {
        var r = users.get(i)
        if (r.user() == u) {
            out.add(RoomUser(u, now))
            found = 1
        } else {
            if (now - r.seen() < 120000) {
                out.add(r)
            }
        }
        i = i + 1
    }
    if (found == 0) {
        out.add(RoomUser(u, now))
    }
    return out
}

String holderOf(RoomState st) {
    var h = st.holder()
    if (h == null) {
        return ""
    }
    return h
}

String roomPush(String dir, String id, String rawUser, String code) {
    if (validRoomId(id) == false) {
        return "{\"error\":\"sala invalida (a-z, 0-9, -, max 32)\"}"
    }
    var u = displayUser(rawUser)
    var c = code
    if (c == null) {
        c = ""
    }
    if (c.length > 65536) {
        return "{\"error\":\"codigo excede o limite de 64KB\"}"
    }
    var now = time.now()
    var users = listOf<RoomUser>()
    var holder = ""
    var prev = File(roomPath(dir, id)).readText()
    if (prev != null && prev != "") {
        try {
            var st = json.decode<RoomState>(prev)
            users = st.users()
            holder = holderOf(st)
        } catch (Exception e) {
        }
    }
    users = touchUser(users, u, now)
    if (holder != "" && holder != u) {
        return "{\"error\":\"piloto é " + holder + "\"}"
    }
    if (holder == "") {
        holder = u
    }
    var d = Directory(dir)
    d.createDirectories()
    File(roomPath(dir, id)).writeText(json.encode(RoomState(c, u, now, users, holder)))
    return roomStateJson(dir, id)
}

Bool holderStale(List<RoomUser> users, String h, Long now) {
    var i = 0
    while (i < users.size()) {
        var r = users.get(i)
        if (r.user() == h) {
            if (now - r.seen() > 60000) {
                return true
            }
            return false
        }
        i = i + 1
    }
    return true
}

String roomHold(String dir, String id, String rawUser) {
    if (validRoomId(id) == false) {
        return "{\"error\":\"sala invalida (a-z, 0-9, -, max 32)\"}"
    }
    var u = displayUser(rawUser)
    var now = time.now()
    var code = ""
    var by = ""
    var holder = ""
    var users = listOf<RoomUser>()
    var prev = File(roomPath(dir, id)).readText()
    if (prev != null && prev != "") {
        try {
            var st = json.decode<RoomState>(prev)
            code = st.code()
            by = st.updatedBy()
            users = st.users()
            holder = holderOf(st)
        } catch (Exception e) {
        }
    }
    if (holder != "" && holder != u && holderStale(users, holder, now) == false) {
        return "{\"error\":\"piloto é " + holder + "\"}"
    }
    holder = u
    users = touchUser(users, u, now)
    var d = Directory(dir)
    d.createDirectories()
    File(roomPath(dir, id)).writeText(json.encode(RoomState(code, by, now, users, holder)))
    return roomStateJson(dir, id)
}

String roomRelease(String dir, String id, String rawUser) {
    if (validRoomId(id) == false) {
        return "{\"error\":\"sala invalida (a-z, 0-9, -, max 32)\"}"
    }
    var u = displayUser(rawUser)
    var now = time.now()
    var code = ""
    var by = ""
    var holder = ""
    var users = listOf<RoomUser>()
    var prev = File(roomPath(dir, id)).readText()
    if (prev != null && prev != "") {
        try {
            var st = json.decode<RoomState>(prev)
            code = st.code()
            by = st.updatedBy()
            users = st.users()
            holder = holderOf(st)
        } catch (Exception e) {
        }
    }
    if (holder == u) {
        holder = ""
    }
    users = touchUser(users, u, now)
    var d = Directory(dir)
    d.createDirectories()
    File(roomPath(dir, id)).writeText(json.encode(RoomState(code, by, now, users, holder)))
    return roomStateJson(dir, id)
}

String roomStateJson(String dir, String id) {
    if (validRoomId(id) == false) {
        return "{\"error\":\"sala invalida (a-z, 0-9, -, max 32)\"}"
    }
    var t = File(roomPath(dir, id)).readText()
    if (t == null) {
        return "{\"code\":\"\",\"updatedBy\":\"\",\"updatedAt\":0,\"users\":[]}"
    }
    if (t == "") {
        return "{\"code\":\"\",\"updatedBy\":\"\",\"updatedAt\":0,\"users\":[]}"
    }
    return t
}

String roomTouch(String dir, String id, String rawUser) {
    if (validRoomId(id) == false) {
        return "{\"error\":\"sala invalida (a-z, 0-9, -, max 32)\"}"
    }
    var u = displayUser(rawUser)
    var now = time.now()
    var code = ""
    var by = ""
    var holder = ""
    var users = listOf<RoomUser>()
    var prev = File(roomPath(dir, id)).readText()
    if (prev != null && prev != "") {
        try {
            var st = json.decode<RoomState>(prev)
            code = st.code()
            by = st.updatedBy()
            users = st.users()
            holder = holderOf(st)
        } catch (Exception e) {
        }
    }
    users = touchUser(users, u, now)
    var d = Directory(dir)
    d.createDirectories()
    File(roomPath(dir, id)).writeText(json.encode(RoomState(code, by, now, users, holder)))
    return roomStateJson(dir, id)
}
