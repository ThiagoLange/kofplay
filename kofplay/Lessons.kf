String lessonsJson() {
    return json.encode(allLessons())
}

Int lessonCount() {
    var items = allLessons()
    return items.size()
}

Lesson findLesson(String id) {
    var items = allLessons()
    for (var l in items) {
        if (l.id() == id) {
            return l
        }
    }
    return Lesson("missing", "missing", "", 0, "", "", "", "", "", "", "", "")
}

Bool lessonExists(String id) {
    var l = findLesson(id)
    if (l.id() == "missing") {
        return false
    }
    return true
}

// ---- Testes (`kof test kofplay/Lessons.kf`) ----

test "catalogo tem 30 licoes" {
    assert(lessonCount() == 30)
}

test "ids sao unicos" {
    var items = allLessons()
    for (var i = 0; i < items.size(); i++) {
        for (var j = i + 1; j < items.size(); j++) {
            assert(items.get(i).id() != items.get(j).id())
        }
    }
}

test "lookup por id" {
    var l = findLesson("funcoes")
    assert(l.title() == "Sua primeira função")
    assert(l.xp() == 20)
    assert(lessonExists("fizzbuzz"))
    assert(lessonExists("nao-existe") == false)
}

test "expected termina com quebra de linha" {
    var items = allLessons()
    for (var l in items) {
        assert(l.expected().contains("\n"))
    }
}

test "toda licao tem variante portukof" {
    var items = allLessons()
    for (var l in items) {
        assert(l.starterPtkf().contains("principal"))
        assert(l.solutionPtkf().contains("principal"))
        assert(l.hintPtkf().length() > 0)
    }
}
